generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PermissionAction {
  VIEW
  CREATE
  UPDATE
  DELETE
  IMPORT
  EXPORT
}

enum AccountType {
  CUSTOMER
  SUPPLIER
}

enum ContactStatus {
  ACTIVE
  INACTIVE
}

enum DataSourceType {
  CSV
  XLSX
}

enum DataSourceStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum DatasetFieldType {
  STRING
  NUMBER
  DATE
  BOOLEAN
}

enum DatasetFieldRole {
  DIMENSION
  MEASURE
  DATE
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      String   @default("trial")
  createdAt DateTime @default(now())

  users            User[]
  invitations      Invitation[]
  dataSources      DataSource[]
  datasets         Dataset[]
  dashboards       Dashboard[]
  scheduledReports ScheduledReport[]
  alerts           Alert[]
  auditLogs        AuditLog[]
  modules          TenantModule[]
  accounts         Account[]
  contacts         Contact[]
  sectorOptions    SectorOption[]
  settings         TenantSetting[]
  roles            Role[]

  @@map("tenants")
}

model User {
  id              String    @id @default(uuid())
  tenantId        String
  email           String    @unique
  passwordHash    String
  name            String
  isActive        Boolean   @default(true)
  isPlatformAdmin Boolean   @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  roles  UserRoleLink[]

  @@index([tenantId])
  @@map("users")
}

/** SUPERADMIN ve COMPANYADMIN sabit/koda gomulu roller olarak isSystem=true ile temsil
 * edilir (COMPANYADMIN her tenant'ta kayit sirasinda otomatik olusur). isBasic=true olan
 * rol, bir rol silindiginde o role sahip kullanicilarin dusecegi, tenant basina tam 1 adet
 * bulunan silinemez rol("Temel Kullanici")dir. Bunlarin disindaki roller COMPANYADMIN
 * tarafindan serbestce olusturulan/silinen dinamik rollerdir - isimleri kod icinde asla
 * gecmez (bkz. CLAUDE.md SS0/SS5, docs/PLAN_ROL_YONETIMI.md SS0). */
model Role {
  id             String   @id @default(uuid())
  tenantId       String
  name           String
  isSystem       Boolean  @default(false)
  isBasic        Boolean  @default(false)
  /** true ise guard bu rolu tasiyan kullaniciyi Page Registry'deki TUM sayfa/aksiyonlara
   * (gelecekte eklenecekler dahil) yetkili sayar - RolePermission satiri gerektirmez.
   * Sadece tenant kaydi sirasinda otomatik olusturulan COMPANYADMIN rolunde true'dur. */
  isCompanyAdmin Boolean  @default(false)
  createdAt      DateTime @default(now())

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  users       UserRoleLink[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

/** pageKey, core/modules/page-registry.ts'teki PAGE_REGISTRY key'lerine karsi whitelist
 * dogrulanir (sorgu motorunun UNKNOWN_FIELD desenine paralel). tabKey null ise izin sayfanin
 * tamami icin gecerlidir. */
model RolePermission {
  id      String            @id @default(uuid())
  roleId  String
  pageKey String
  tabKey  String?
  action  PermissionAction

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, pageKey, tabKey, action])
  @@index([roleId])
  @@map("role_permissions")
}

model UserRoleLink {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model TenantModule {
  id         String    @id @default(uuid())
  tenantId   String
  moduleKey  String
  enabledAt  DateTime  @default(now())
  disabledAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, moduleKey])
  @@index([tenantId])
  @@map("tenant_modules")
}

model Invitation {
  id         String    @id @default(uuid())
  tenantId   String
  email      String
  roleIds    String[]  @default([])
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("invitations")
}

model DataSource {
  id               String            @id @default(uuid())
  tenantId         String
  name             String
  type             DataSourceType
  originalFileName String
  sizeBytes        Int
  status           DataSourceStatus  @default(PENDING)
  errorMessage     String?
  createdById      String
  createdAt        DateTime          @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  datasets Dataset[]

  @@index([tenantId])
  @@map("data_sources")
}

model Dataset {
  id             String    @id @default(uuid())
  tenantId       String
  dataSourceId   String
  name           String
  physicalTable  String
  rowCount       Int       @default(0)
  lastIngestedAt DateTime?
  createdAt      DateTime  @default(now())

  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  dataSource DataSource     @relation(fields: [dataSourceId], references: [id])
  fields     DatasetField[]

  @@index([tenantId])
  @@map("datasets")
}

model DatasetField {
  id         String           @id @default(uuid())
  datasetId  String
  sourceName String
  name       String
  label      String
  type       DatasetFieldType
  role       DatasetFieldRole
  format     String?
  isVisible  Boolean          @default(true)
  ordinal    Int              @default(0)

  dataset Dataset @relation(fields: [datasetId], references: [id])

  @@index([datasetId])
  @@map("dataset_fields")
}

model Dashboard {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  layout      Json     @default("[]")
  filters     Json     @default("[]")
  createdById String
  createdAt   DateTime @default(now())

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  widgets          Widget[]
  scheduledReports ScheduledReport[]

  @@index([tenantId])
  @@map("dashboards")
}

model Widget {
  id          String   @id @default(uuid())
  dashboardId String
  type        String
  title       String
  querySpec   Json
  vizOptions  Json     @default("{}")
  position    Json
  createdAt   DateTime @default(now())

  dashboard Dashboard @relation(fields: [dashboardId], references: [id])
  alerts    Alert[]

  @@index([dashboardId])
  @@map("widgets")
}

model ScheduledReport {
  id          String   @id @default(uuid())
  tenantId    String
  dashboardId String
  cron        String
  recipients  String[]
  isActive    Boolean  @default(true)
  lastRunAt   DateTime?

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  dashboard Dashboard @relation(fields: [dashboardId], references: [id])

  @@index([tenantId])
  @@map("scheduled_reports")
}

model Alert {
  id              String    @id @default(uuid())
  tenantId        String
  widgetId        String
  operator        String
  threshold       Float
  recipients      String[]
  lastTriggeredAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  widget Widget @relation(fields: [widgetId], references: [id])

  @@index([tenantId])
  @@map("alerts")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  action    String
  entity    String
  entityId  String
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("audit_logs")
}

// CRM (satis) modulu -- bkz. core/modules/module-registry.ts 'crm' anahtari
model Account {
  id           String        @id @default(uuid())
  tenantId     String
  name         String
  taxNumber    String?
  taxOffice    String?
  sector       String?
  accountTypes AccountType[] @default([])
  website      String?
  phone        String?
  email        String?
  address      String?
  city         String?
  ownerId      String?
  customFields Json          @default("{}")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  contacts Contact[]

  @@index([tenantId, name])
  @@index([tenantId, deletedAt])
  @@map("crm_accounts")
}

model Contact {
  id                  String        @id @default(uuid())
  tenantId            String
  accountId           String?
  firstName           String
  lastName            String
  title               String?
  email               String?
  phone               String?
  ownerId             String?
  status              ContactStatus @default(ACTIVE)
  lastContactedAt     DateTime?
  inactivityNotifiedAt DateTime?
  customFields        Json          @default("{}")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  account Account? @relation(fields: [accountId], references: [id])

  @@index([tenantId, lastName])
  @@index([tenantId, deletedAt])
  @@index([tenantId, accountId])
  @@index([tenantId, status])
  @@map("crm_contacts")
}

/** A2: tenant kendi sektor listesini ADMIN/OWNER uzerinden yonetir (bkz. VARSAYIMLAR V18) */
model SectorOption {
  id        String   @id @default(uuid())
  tenantId  String
  label     String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, label])
  @@map("crm_sector_options")
}

/** Genel amacli tenant bazli anahtar-deger ayar deposu (K2 esigi buradan okunur). */
model TenantSetting {
  id        String   @id @default(uuid())
  tenantId  String
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("tenant_settings")
}
