generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PermissionAction {
  VIEW
  CREATE
  UPDATE
  DELETE
  IMPORT
  EXPORT
  APPROVE
}

enum AccountType {
  CUSTOMER
  SUPPLIER
  CONTRACTOR
  SUBCONTRACTOR
}

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
}

enum PurchaseOrderItemSource {
  QUOTE
  EXTRA
}

enum MessageRelatedEntity {
  PROJECT
  QUOTE
  INTERACTION
}

enum MessageRecipientKind {
  TO
  CC
}

/**
 * Generic bildirim mekanizmasi (header'daki zil ikonu) icin - yeni bir ozellik
 * bildirim gondermek istedikce buraya yeni bir deger eklenir (bkz. CLAUDE.md,
 * kullanicinin "TÜRÜ enum olsun" istegi). İlk kullanim: Ajanda/Takvim'de baskasina
 * katilimci olarak atanan bir hatirlatici (bkz. calendar-events.service.ts).
 */
enum NotificationType {
  /**
   * @deprecated Katilimci davet/kabul/red akisina gecilince CALENDAR_EVENT_INVITE'a
   * ayrildi (bkz. docs/VARSAYIMLAR.md) - eski Notification kayitlari icin degeri
   * korunuyor, yeni kod bunu artik uretmiyor.
   */
  CALENDAR_REMINDER_ASSIGNED
  /**
   * Gunluk zamanlayici (check-todays-reminders.processor.ts): bugun baslayan,
   * kullanicinin katilimci oldugu TUM CalendarEvent'leri (kaynagi ne olursa olsun -
   * dogrudan /ajanda'dan kurulan veya bir gorusmeye bagli) tek bir bildirimde
   * toplar, kullanici basina gunde en fazla 1 kez uretilir.
   */
  CALENDAR_REMINDERS_DUE_TODAY
  /**
   * Gunluk zamanlayici (check-contact-inactivity.processor.ts): bir kontakla
   * esik gun sayisi boyunca iletisim kurulmadiginda, tenant'taki TUM aktif
   * kullanicilara tek bir bildirim uretilir (K2, bkz. CLAUDE.md SS2.3.3).
   */
  CONTACT_INACTIVITY_ALERT
  /**
   * Katilimci daveti gonderildiginde davet edilene gider - kabul/red bekler.
   */
  CALENDAR_EVENT_INVITE
  /**
   * Davet edilen kabul/red verince olusturana gider (red notu body'de tasinir).
   */
  CALENDAR_EVENT_RESPONSE
  /**
   * Olusturan, zaten kabul etmis bir katilimcinin etkinliginin saat/gun/basligini
   * degistirdiginde o katilimciya gider.
   */
  CALENDAR_EVENT_UPDATED
  /**
   * isMeeting=true bir hatirlaticinin detayindaki "Toplanti Raporu Olustur" akisindan
   * mesaj gonderilince, mesajin alicilarina gider (bkz. MessagesService.create).
   */
  MEETING_REPORT_SENT
  /**
   * Bir teklif REVIZE durumuna cekildiginde (durum dropdown'u /teklifler listesinde
   * veya /teklifler/:id detayinda) tenant'taki TUM aktif kullanicilara gider -
   * CONTACT_INACTIVITY_ALERT ile ayni "tenant genelinde yayin" deseni.
   */
  QUOTE_REVISION_REQUESTED
}

enum ContactStatus {
  ACTIVE
  INACTIVE
}

enum InteractionStatus {
  OPEN
  CLOSED
}

enum OpportunityStage {
  NEW
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum CurrencyCode {
  TRY
  USD
  EUR
  GBP
  CHF
  JPY
}

/**
 * Bkz. docs/VARSAYIMLAR.md V27: politika asimi yoksa olusturma aninda dogrudan APPROVED,
 * asim varsa PENDING_APPROVAL (APPROVE izniyle sonuclanir). DRAFT sema uyumlulugu icin
 * tutuluyor, Faz 11d'nin senkron olusturma akisi hic uretmiyor.
 */
enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  REVIZE
  /**
   * Ad-hoc /teklifler Excel ice aktarma (bkz. docs/VARSAYIMLAR.md) - import'tan
   * gelen tekliflerin baslangic durumu. Normal /teklifler/yeni akisi hic uretmez.
   */
  UNSPECIFIED
}

/**
 * Ad-hoc: /teklifler Excel ice aktarma (bkz. docs/VARSAYIMLAR.md). Kaynak dosyalarda
 * cogu zaman satir bazli urun/miktar/birim fiyat kolonu olmuyor, sadece teklifin
 * toplam tutari var - bu yuzden Quote icin "kalemsiz, toplam tutari elle/import ile
 * girilen" ikinci bir mod eklendi. ITEMIZED (varsayilan) mevcut QuoteItem tabanli
 * akisin tamami (QuotesService.create/update/approve, indirim-onay, stok dusumu,
 * PO olusturma) - hic degismedi. MANUAL_TOTAL sadece quote-imports modulunun yazdigi
 * kayitlarda kullanilir, normal /teklifler/yeni formu bu modu uretmez.
 */
enum QuoteItemsEntryMode {
  ITEMIZED
  MANUAL_TOTAL
}

enum DataSourceType {
  CSV
  XLSX
}

enum DataSourceStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum DatasetFieldType {
  STRING
  NUMBER
  DATE
  BOOLEAN
}

enum DatasetFieldRole {
  DIMENSION
  MEASURE
  DATE
}

/**
 * Faz 11f (R1-R2, bkz. docs/VARSAYIMLAR.md V29): UPLOAD = CSV/XLSX'ten ingest edilen
 * klasik dataset (tenant_<id>.ds_<uuid>). CRM_TABLE = CRM verisini raporlayan, provisioning
 * ile olusturulan sentetik dataset; fiziksel karsiligi paylasimli semadaki bir Postgres
 * view'i (Dataset.physicalTable), sorgu motoru tenantId'yi zorunlu WHERE olarak ekler.
 */
enum DatasetSourceKind {
  UPLOAD
  CRM_TABLE
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      String   @default("trial")
  /**
   * Sirket logosu (R2 storage key) - kullanici avatariyla ayni desen
   * (bkz. R2StorageService doc comment'i), /settings?tab=crm'de yonetilir.
   */
  logoKey   String?
  /**
   * Sirket bilgileri (adres/telefon/eposta) - /settings?tab=crm'deki "Sirket
   * Bilgileri" bolumunden (eski "Sirket Logosu") yonetilir. Markali teklif
   * sablonunun (QuoteTemplate) eskiden sablon basina tuttugu companyPhone/
   * companyEmail/companyAddressLines alanlarinin yerini aldi - tek bir tenant
   * sadece tek bir sirket adresine/telefonuna/epostasina sahip olabilir,
   * sablon basina tekrar tanimlanmasi gereksizdi.
   */
  address   String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                    User[]
  dataSources              DataSource[]
  datasets                 Dataset[]
  dashboards               Dashboard[]
  scheduledReports         ScheduledReport[]
  alerts                   Alert[]
  auditLogs                AuditLog[]
  modules                  TenantModule[]
  accounts                 Account[]
  contacts                 Contact[]
  sectorOptions            SectorOption[]
  departmentOptions        DepartmentOption[]
  titleOptions             TitleOption[]
  productCategoryOptions   ProductCategoryOption[]
  brandOptions             BrandOption[]
  unitOptions              UnitOption[]
  paymentMethodOptions     PaymentMethodOption[]
  ibanOptions              IbanOption[]
  settings                 TenantSetting[]
  roles                    Role[]
  calendarEvents           CalendarEvent[]
  calendarShares           CalendarShare[]
  reminderTypeOptions      ReminderTypeOption[]
  interactions             Interaction[]
  interactionTypeOptions   InteractionTypeOption[]
  opportunities            Opportunity[]
  products                 Product[]
  productLists             ProductList[]
  quotes                   Quote[]
  quoteTemplates           QuoteTemplate[]
  postSaleCases            PostSaleCase[]
  feedbackSurveys          FeedbackSurvey[]
  projects                 Project[]
  projectAttachments       ProjectAttachment[]
  purchaseOrders           PurchaseOrder[]
  stockItems               StockItem[]
  stockMovements           StockMovement[]
  quoteStatusHistories     QuoteStatusHistory[]
  warehouses               Warehouse[]
  messages                 Message[]
  messageStars             MessageStar[]
  messageAttachments       MessageAttachment[]
  notifications            Notification[]
  drawingLibraryComponents DrawingLibraryComponent[]
  drawingPanelTemplates    DrawingPanelTemplate[]
  drawings                 Drawing[]

  @@map("tenants")
}

model User {
  id                String    @id @default(uuid())
  tenantId          String
  email             String    @unique
  passwordHash      String
  name              String
  isActive          Boolean   @default(true)
  isPlatformAdmin   Boolean   @default(false)
  avatarKey         String?
  /**
   * G3-genislemesi: teklif "gonderen" bilgisinde (Quote.senderId) gosterilen
   * unvan/telefon - /profile?tab=general'deki "Bilgilerini Duzenle" bolumunden
   * kullanicinin kendisi tarafindan setlenir.
   */
  title             String?
  phone             String?
  defaultPageSize   Int       @default(25)
  /**
   * Sayfa anahtari (pageKey) -> gorunur kolon anahtarlari. Liste sayfalarindaki
   * "Gosterilecek kolonlar" secicisi icin - null/eksik anahtar = tum kolonlar gorunur
   * (varsayilan). Kullanici bazli, tenant genelinde paylasilmaz.
   */
  columnPreferences Json?
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  roles  UserRoleLink[]

  @@index([tenantId])
  @@map("users")
}

/**
 * SUPERADMIN ve COMPANYADMIN sabit/koda gomulu roller olarak isSystem=true ile temsil
 * edilir (COMPANYADMIN her tenant'ta kayit sirasinda otomatik olusur). isBasic=true olan
 * rol, bir rol silindiginde o role sahip kullanicilarin dusecegi, tenant basina tam 1 adet
 * bulunan silinemez rol("Temel Kullanici")dir. Bunlarin disindaki roller COMPANYADMIN
 * tarafindan serbestce olusturulan/silinen dinamik rollerdir - isimleri kod icinde asla
 * gecmez (bkz. CLAUDE.md SS0/SS5, docs/PLAN_ROL_YONETIMI.md SS0).
 */
model Role {
  id             String   @id @default(uuid())
  tenantId       String
  name           String
  isSystem       Boolean  @default(false)
  isBasic        Boolean  @default(false)
  /**
   * true ise guard bu rolu tasiyan kullaniciyi Page Registry'deki TUM sayfa/aksiyonlara
   * (gelecekte eklenecekler dahil) yetkili sayar - RolePermission satiri gerektirmez.
   * Sadece tenant kaydi sirasinda otomatik olusturulan COMPANYADMIN rolunde true'dur.
   */
  isCompanyAdmin Boolean  @default(false)
  createdAt      DateTime @default(now())

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  users       UserRoleLink[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

/**
 * pageKey, core/modules/page-registry.ts'teki PAGE_REGISTRY key'lerine karsi whitelist
 * dogrulanir (sorgu motorunun UNKNOWN_FIELD desenine paralel). tabKey null ise izin sayfanin
 * tamami icin gecerlidir.
 */
model RolePermission {
  id      String           @id @default(uuid())
  roleId  String
  pageKey String
  tabKey  String?
  action  PermissionAction

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, pageKey, tabKey, action])
  @@index([roleId])
  @@map("role_permissions")
}

model UserRoleLink {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model TenantModule {
  id         String    @id @default(uuid())
  tenantId   String
  moduleKey  String
  enabledAt  DateTime  @default(now())
  disabledAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, moduleKey])
  @@index([tenantId])
  @@map("tenant_modules")
}

/// Hangi sayfanin (core/modules/page-registry.ts PAGE_REGISTRY) hangi modul(ler)e
/// (core/modules/module-registry.ts MODULE_REGISTRY) ait oldugunu tutar. Global bir
/// esleme - tenant'a bagli degil, tenantScopedExtension'a eklenmez. Bir sayfa birden
/// fazla modulde olabilir (satir basina bir pageKey+moduleKey), tenant bunlardan
/// HERHANGI birine sahipse sayfa erisilebilir sayilir (bkz. TenantsService.listPageAccess).
/// Bir pageKey icin hic satir yoksa sayfa herhangi bir modul gerektirmez (core gibi davranir).
model PageModuleAssignment {
  pageKey   String
  moduleKey String
  updatedAt DateTime @updatedAt

  @@id([pageKey, moduleKey])
  @@map("page_module_assignments")
}

model DataSource {
  id               String           @id @default(uuid())
  tenantId         String
  name             String
  type             DataSourceType
  originalFileName String
  sizeBytes        Int
  status           DataSourceStatus @default(PENDING)
  errorMessage     String?
  headerRowIndex   Int              @default(0)
  createdById      String
  createdAt        DateTime         @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  datasets Dataset[]

  @@index([tenantId])
  @@map("data_sources")
}

model Dataset {
  id             String            @id @default(uuid())
  tenantId       String
  dataSourceId   String?
  name           String
  physicalTable  String
  sourceKind     DatasetSourceKind @default(UPLOAD)
  rowCount       Int               @default(0)
  lastIngestedAt DateTime?
  createdAt      DateTime          @default(now())

  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  dataSource DataSource?    @relation(fields: [dataSourceId], references: [id])
  fields     DatasetField[]

  @@index([tenantId])
  @@map("datasets")
}

model DatasetField {
  id         String           @id @default(uuid())
  datasetId  String
  sourceName String
  name       String
  label      String
  type       DatasetFieldType
  role       DatasetFieldRole
  format     String?
  isVisible  Boolean          @default(true)
  ordinal    Int              @default(0)

  dataset Dataset @relation(fields: [datasetId], references: [id])

  @@index([datasetId])
  @@map("dataset_fields")
}

model Dashboard {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  layout      Json     @default("[]")
  filters     Json     @default("[]")
  createdById String
  createdAt   DateTime @default(now())

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  widgets          Widget[]
  scheduledReports ScheduledReport[]

  @@index([tenantId])
  @@map("dashboards")
}

model Widget {
  id          String   @id @default(uuid())
  dashboardId String
  type        String
  title       String
  querySpec   Json
  vizOptions  Json     @default("{}")
  position    Json
  createdAt   DateTime @default(now())

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  alerts    Alert[]

  @@index([dashboardId])
  @@map("widgets")
}

model ScheduledReport {
  id          String    @id @default(uuid())
  tenantId    String
  dashboardId String
  cron        String
  recipients  String[]
  isActive    Boolean   @default(true)
  lastRunAt   DateTime?

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("scheduled_reports")
}

model Alert {
  id              String    @id @default(uuid())
  tenantId        String
  widgetId        String
  operator        String
  threshold       Float
  recipients      String[]
  lastTriggeredAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  widget Widget @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("alerts")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  action    String
  entity    String
  entityId  String
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("audit_logs")
}

// CRM (satis) modulu -- bkz. core/modules/module-registry.ts 'crm' anahtari
model Account {
  id            String        @id @default(uuid())
  tenantId      String
  name          String
  taxNumber     String?
  taxOffice     String?
  sector        String[]      @default([])
  accountTypes  AccountType[] @default([])
  website       String?
  phone         String?
  landlinePhone String?
  email         String?
  address       String?
  city          String?
  district      String?
  ownerId       String?
  customFields  Json          @default("{}")
  /**
   * Kaydi olusturan kullanici (bkz. UsersService.getUserStats - "oluşturduğu firmalar" KPI'i).
   * ownerId'den farkli: ownerId elle atanan "sorumlu kisi", bu ise degistirilemez, olusturma
   * aninda set edilen gercek yaratici. Nullable: bu alan eklenmeden once olusturulmus kayitlar
   * icin backfill migration'i audit_logs'taki en eski CREATE kaydindan doldurur, ama tum eski
   * kayitlarda karsilik gelen bir audit log garanti degil.
   */
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  contacts      Contact[]
  interactions  Interaction[]
  opportunities Opportunity[]
  quotes        Quote[]
  postSaleCases PostSaleCase[]
  projects      Project[]

  @@index([tenantId, name])
  @@index([tenantId, deletedAt])
  @@map("crm_accounts")
}

model Contact {
  id                   String        @id @default(uuid())
  tenantId             String
  accountId            String?
  firstName            String
  lastName             String
  department           String?
  title                String?
  email                String?
  phone                String?
  extension            String?
  ownerId              String?
  status               ContactStatus @default(ACTIVE)
  lastContactedAt      DateTime?
  inactivityNotifiedAt DateTime?
  customFields         Json          @default("{}")
  /**
   * bkz. Account.createdById doc comment - ayni gerekce/nullable karari.
   */
  createdById          String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  account         Account?         @relation(fields: [accountId], references: [id])
  interactions    Interaction[]
  quotes          Quote[]
  postSaleCases   PostSaleCase[]
  feedbackSurveys FeedbackSurvey[]

  @@index([tenantId, lastName])
  @@index([tenantId, deletedAt])
  @@index([tenantId, accountId])
  @@index([tenantId, status])
  @@map("crm_contacts")
}

/**
 * A2: tenant kendi sektor listesini ADMIN/OWNER uzerinden yonetir (bkz. VARSAYIMLAR V18)
 */
model SectorOption {
  id        String   @id @default(uuid())
  tenantId  String
  label     String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, label])
  @@map("crm_sector_options")
}

model DepartmentOption {
  id        String   @id @default(uuid())
  tenantId  String
  label     String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, label])
  @@map("crm_department_options")
}

model TitleOption {
  id        String   @id @default(uuid())
  tenantId  String
  label     String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, label])
  @@map("crm_title_options")
}

/**
 * U1: tenant kendi urun kategori listesini yonetir; Product.category zaten
 * serbest metin (bkz. VARSAYIMLAR V32), bu liste sadece Autocomplete oneri
 * kaynagi - Sektor/Departman/Unvan ile ayni desen.
 */
model ProductCategoryOption {
  id        String   @id @default(uuid())
  tenantId  String
  label     String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, label])
  @@map("crm_product_category_options")
}

/**
 * Tenant kendi marka listesini yonetir; Product.brand serbest metin (Sektor/Departman/
 * Unvan/Urun Kategorisi ile ayni desen) - bu liste sadece Autocomplete oneri kaynagi.
 */
model BrandOption {
  id        String   @id @default(uuid())
  tenantId  String
  label     String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, label])
  @@map("crm_brand_options")
}

/**
 * Tenant kendi birim listesini yonetir (ör. adet, kg, kutu, metre); Product.unit artik
 * serbest metin degil, bu listeden secilir - Sektor/Departman/Unvan/Urun Kategorisi/
 * Marka ile ayni desen.
 */
model UnitOption {
  id        String   @id @default(uuid())
  tenantId  String
  label     String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, label])
  @@map("crm_unit_options")
}

/**
 * Teklif "odeme yontemi" alani icin tenant'in tanimladigi liste - Sektor/Departman/
 * Unvan/Urun Kategorisi ile ayni desen. Quote.paymentMethod bu listedeki label'a
 * karsi dogrulanir (bkz. QuotesService.assertValidPaymentMethod).
 */
model PaymentMethodOption {
  id        String   @id @default(uuid())
  tenantId  String
  label     String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, label])
  @@map("crm_payment_method_options")
}

/**
 * Teklifin "banka bilgileri" bolumu icin tenant'in tanimladigi IBAN listesi.
 * Quote secilen bir IbanOption'in 4 alanini olusturma/guncelleme aninda kendi
 * uzerine kopyalar (bkz. QuotesService.resolveIbanSnapshot) - Q3'teki
 * unitPrice'in Product.price'tan kopyalanmasiyla ayni desen, boylece IbanOption
 * sonradan degistirilse/silinse bile mevcut teklifler etkilenmez.
 */
model IbanOption {
  id                String   @id @default(uuid())
  tenantId          String
  bankName          String
  accountHolderName String
  accountNumber     String?
  iban              String
  createdAt         DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("crm_iban_options")
}

/**
 * Genel amacli tenant bazli anahtar-deger ayar deposu (K2 esigi buradan okunur).
 */
model TenantSetting {
  id        String   @id @default(uuid())
  tenantId  String
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("tenant_settings")
}

/**
 * Faz 11b (Ajanda/Takvim, T1-T4) - bkz. docs/VARSAYIMLAR.md V23. relatedEntityType
 * bilincli olarak enum degil String: Interaction/Quote/Project modelleri henuz yok
 * (Faz 11c/11d/11g), gecerli deger listesi uygulama katmaninda kontrol edilecek.
 */
model CalendarEvent {
  id                String    @id @default(uuid())
  tenantId          String
  title             String
  description       String?
  /**
   * Tenant'in /settings?tab=crm > Ajanda'da yonettigi dinamik ReminderTypeOption
   * listesine karsi dogrulanan serbest metin - InteractionTypeOption/Interaction.type
   * ile ayni desen (bkz. CalendarEventsService.assertValidReminderType).
   */
  reminderType      String?
  startAt           DateTime
  endAt             DateTime
  allDay            Boolean   @default(false)
  /**
   * "Bu bir toplantıdır" onay kutusu - hatırlatıcı türünün altında, toplantı olarak isaretlenen etkinlikleri ayirt eder.
   */
  isMeeting         Boolean   @default(false)
  relatedEntityType String?
  relatedEntityId   String?
  createdById       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  tenant    Tenant                  @relation(fields: [tenantId], references: [id])
  attendees CalendarEventAttendee[]

  @@index([tenantId, startAt])
  @@index([tenantId, deletedAt])
  @@map("crm_calendar_events")
}

/**
 * Ajanda paylasim izni: ownerId kendi ajandasini viewerId'ye acar (tek yonlu,
 * karsilikli degil). CalendarEventAttendee.userId ile ayni desen: gercek FK
 * degil (User relation'i yok, sadece id). /profile?tab=security'de ownerId=ben
 * olan satirlar (kime izin verdigim) coklu secim ile yonetilir; /ajanda'daki
 * tek secimli dropdown viewerId=ben olan satirlari (kimin ajandasini gorebilirim)
 * listeler.
 */
model CalendarShare {
  id        String   @id @default(uuid())
  tenantId  String
  ownerId   String
  viewerId  String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, ownerId, viewerId])
  @@map("crm_calendar_shares")
}

/**
 * M6: her katilimciya kendi aciklamasi - "note" bu ihtiyaci karsilar.
 */
model CalendarEventAttendee {
  id         String    @id @default(uuid())
  eventId    String
  userId     String
  note       String?
  /**
   * Faz 11c M4/M8/M9: hatirlatma e-postasi bu kullaniciya gonderildiginde damgalanir
   * (Contact.inactivityNotifiedAt ile ayni desen) - tekrar gonderimi engeller.
   */
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  /**
   * Ad-hoc (2026-09-29): katilimci artik otomatik eklenmiyor, davet edilip kabul/red
   * bekliyor (bkz. docs/VARSAYIMLAR.md). Olusturanin kendi satiri CalendarEventsService
   * tarafindan dogrudan ACCEPTED olarak yaratilir - varsayilan PENDING sadece BASKA
   * kullanicilar icin gecerlidir. list()/getById() PENDING/DECLINED bir katilimcinin
   * kendi takvim izgarasinda etkinligi gostermez (respond() ile ACCEPTED olana kadar).
   */
  status       CalendarAttendeeStatus @default(PENDING)
  /**
   * Yanitlarken girilen not - DECLINED'ta zorunlu, ACCEPTED'ta opsiyonel. Olusturanin
   * /ajanda altindaki "gonderdigim davetler" tablosunda kalici olarak gorunur.
   */
  responseNote String?
  /**
   * Kullanici respond() cagirdiginda damgalanir; creator icin create() aninda set edilir.
   */
  respondedAt  DateTime?

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("crm_calendar_event_attendees")
}

enum CalendarAttendeeStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/**
 * Faz 11c (Gorusme/Aktivite, M1-M10) - bkz. docs/VARSAYIMLAR.md V26. Hatirlatma (M4-M9)
 * icin ayri bir CalendarReminder modeli KURULMADI - CalendarEvent/CalendarEventAttendee
 * (Faz 11b) relatedEntityType='Interaction' ile yeniden kullaniliyor, bkz. VARSAYIMLAR.md V26.
 */
model Interaction {
  id                  String            @id @default(uuid())
  tenantId            String
  accountId           String?
  contactId           String?
  /**
   * Eskiden sabit InteractionType enum'iydi (CALL/VISIT/MEETING/EMAIL/OTHER) - kullanicinin
   * ice aktardigi Excel'lerdeki "Gorusme Sekli" degerleri bu 5 sabitle sinirli olmadigindan
   * tenant'in /settings?tab=crm'de yonettigi dinamik InteractionTypeOption listesine karsi
   * dogrulanan serbest metne cevrildi (bkz. AccountsService.assertValidSector ile ayni "bos
   * listede serbest gec" deseni, InteractionsService.assertValidInteractionType).
   */
  type                String
  /**
   * Ice aktarma (interaction-imports) "Konu" kolonu icin eklendi - serbest metin, zorunlu degil.
   */
  subject             String?
  /**
   * Konu (subject) eklendikten sonra artik zorunlu degil - gorusme sadece bir konu
   * basligiyla da anlamli olabilir.
   */
  notes               String?
  occurredAt          DateTime
  status              InteractionStatus @default(OPEN)
  /**
   * M2: bilinmeyen firma serbest metinle girildiyse otomatik olusan cari - bildirim icin.
   */
  accountAutoCreated  Boolean           @default(false)
  /**
   * M1: bilinmeyen kisi serbest metinle girildiyse otomatik olusan kontak - bildirim icin.
   */
  contactAutoCreated  Boolean           @default(false)
  /**
   * Excel/CSV ice aktarmada eslenmeyen sutunlar icin catch-all - Account.customFields ile
   * ayni desen (bkz. docs/VARSAYIMLAR.md V41, /gorusmeler ice aktarma "ozel alan" secenegi).
   */
  customFields        Json              @default("{}")
  /**
   * Gorusme detay sayfasindaki "Bagli Gorusme Ekle" (yesil +) butonuyla eklenen ek gorusme
   * kayitlari icin self-relation - bu alan doluysa kayit /gorusmeler ana listesinde GOSTERILMEZ
   * (InteractionsService.list varsayilan filtresi), sadece ait oldugu ana gorusmenin detay
   * sayfasinda kart olarak gorunur. Ana kayit silinirse bagli kayitlar da cascade silinir.
   */
  parentInteractionId String?
  /**
   * Gorusmeyi fiilen yapan kullanici - createdById ile ayni desen (iliskisel FK degil,
   * serbest String), kaydi SISTEME girenden farkli olabilir (orn. asistan baskasi adina
   * girer). Su an sadece "Bagli Gorusme Ekle" modalindan doldurulur, varsayilani o anki
   * kullanicidir ama degistirilebilir.
   */
  performedByUserId   String?
  createdById         String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?

  tenant             Tenant                   @relation(fields: [tenantId], references: [id])
  account            Account?                 @relation(fields: [accountId], references: [id])
  contact            Contact?                 @relation(fields: [contactId], references: [id])
  opportunity        Opportunity?
  participants       InteractionParticipant[]
  parentInteraction  Interaction?             @relation("InteractionLinked", fields: [parentInteractionId], references: [id], onDelete: Cascade)
  linkedInteractions Interaction[]            @relation("InteractionLinked")

  @@index([tenantId, accountId])
  @@index([tenantId, occurredAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId, parentInteractionId])
  @@map("crm_interactions")
}

/**
 * M10: cari kayda eklenmesi istenmeyen katilimcilar (bizim taraf + karsi taraf).
 * CalendarEventAttendee gibi ayri tenantId tasimaz, interaction uzerinden cascade silinir.
 */
model InteractionParticipant {
  id            String   @id @default(uuid())
  interactionId String
  name          String
  isInternal    Boolean
  note          String?
  createdAt     DateTime @default(now())

  interaction Interaction @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  @@map("crm_interaction_participants")
}

/**
 * Gorusme ekleme/duzenleme formundaki "Gorusme Sekli" dropdown'unun tenant bazli listesi -
 * PaymentMethodOption/SectorOption ile ayni desen. Ice aktarmada (interaction-imports) Excel
 * degeri bu listede yoksa otomatik olarak buraya yeni bir satir eklenir (kullanici karari).
 */
model InteractionTypeOption {
  id        String   @id @default(uuid())
  tenantId  String
  label     String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, label])
  @@map("crm_interaction_type_options")
}

/**
 * "Yeni Etkinlik" modalindeki "Hatirlatici Turu" dropdown'unun tenant bazli listesi -
 * InteractionTypeOption ile ayni desen. /settings?tab=crm > Ajanda bolumunden yonetilir.
 */
model ReminderTypeOption {
  id        String   @id @default(uuid())
  tenantId  String
  label     String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, label])
  @@map("crm_reminder_type_options")
}

/**
 * quoteId Faz 11d'de gercek FK'ya yukseltildi (Quote modeli artik var) - bkz.
 * docs/VARSAYIMLAR.md V26 (baslangicta gevsek birakilma gerekcesi) / V27 (O2, FK'ya yukseltme).
 */
model Opportunity {
  id                     String           @id @default(uuid())
  tenantId               String
  accountId              String
  interactionId          String?          @unique
  quoteId                String?          @unique
  name                   String
  stage                  OpportunityStage @default(NEW)
  estimatedValue         Decimal?         @db.Decimal(14, 2)
  estimatedValueCurrency CurrencyCode     @default(TRY)
  description            String?
  occurredAt             DateTime         @default(now())
  createdById            String
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  deletedAt              DateTime?

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  account     Account      @relation(fields: [accountId], references: [id])
  interaction Interaction? @relation(fields: [interactionId], references: [id])
  quote       Quote?       @relation(fields: [quoteId], references: [id])

  @@index([tenantId, accountId])
  @@index([tenantId, stage])
  @@index([tenantId, deletedAt])
  @@map("crm_opportunities")
}

/**
 * Faz 11d taslagi (CLAUDE.md SS7.2 U1/Q3) - Quote'un ihtiyac duydugu minimal urun kaydi.
 * Tam katalog (stok entegrasyonu) Faz 11h/11i'de genisletilecek, bkz. docs/VARSAYIMLAR.md V27.
 * minStockLevel simdiden eklendi (Faz 11h ST1'de kullanilacak) ama bu fazda okunmuyor/UI'da
 * zorunlu degil. maxDiscountPct Q7'nin "urun basina azami iskonto orani" ihtiyacini
 * karsilar - taslak semadaki ayri `ProductDiscountPolicy` modeli KURULMADI (bire-bir 1:1,
 * ek alani olmayan bir iliski icin gereksiz bir tablo/CRUD olurdu), bkz. VARSAYIMLAR V27.
 */
model Product {
  id             String    @id @default(uuid())
  tenantId       String
  productListId  String
  name           String
  sku            String?
  unit           String    @default("adet")
  minStockLevel  Int?
  maxDiscountPct Decimal?  @db.Decimal(5, 2)
  /**
   * Ad-hoc (2026-09-19, bkz. docs/VARSAYIMLAR.md V37): PriceList/PriceListItem
   * kaldirildi, fiyat artik dogrudan Product uzerinde. currency ice aktarilan
   * fiyatin oldugu gibi saklanmasi icin eklendi - kur cevrimi YOK.
   */
  price          Decimal?  @db.Decimal(14, 2)
  currency       String    @default("TRY")
  /**
   * Faz B (bkz. docs/VARSAYIMLAR.md V40): marka'ya ozgu, bilinen bir Product alanina
   * eslenmeyen ice aktarma kolonlari icin catch-all (orn. Schneider'in "Seri" kolonu).
   * Kaynak kolon basligi -> deger (string) seklinde saklanir.
   */
  attributes     Json?
  description    String?
  category       String?
  brand          String?
  /**
   * Hareketli agirlikli ortalama maliyet (WAC) - bkz. docs/PLAN_STOK_MALIYET.md.
   * Statik Product.costPrice'in yerini aldi (V49): tek bir urun farkli partilerde
   * farkli fiyattan alinabildigi icin sabit bir maliyet alani yanlisti. Urun
   * bazinda (depo bazinda degil) tutulur - bir urunun tum depolardaki stogu tek
   * bir ortalama maliyeti paylasir. Sadece StockMovement type=INCREASE hareketleri
   * bu alani guncelleri (DECREASE/QUOTE_SALE/CORRECTION/TRANSFER_* degistirmez).
   */
  avgCost        Decimal?  @db.Decimal(14, 4)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  productList        ProductList         @relation(fields: [productListId], references: [id])
  quoteItems         QuoteItem[]
  purchaseOrderItems PurchaseOrderItem[]
  stockItems         StockItem[]
  stockMovements     StockMovement[]
  drawingSpec        ProductDrawingSpec?

  @@index([tenantId, name])
  @@index([tenantId, deletedAt])
  @@index([tenantId, productListId])
  @@map("crm_products")
}

/**
 * Bir tenant'in birden fazla urun katalogu olabilmesi icin eklendi (ProductList).
 * Her Product tam olarak bir ProductList'e aittir (1:N, N:M degil) - bkz.
 * docs/VARSAYIMLAR.md V36. Migration, mevcut tum urun/fiyat listesi kayitlarini
 * otomatik bir "Genel" ProductList'e tasir.
 */
model ProductList {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@index([tenantId, deletedAt])
  @@map("crm_product_lists")
}

/**
 * Q1-Q8 (bkz. docs/VARSAYIMLAR.md V27). quoteNumber formati TEK-YYYY-AA-GG-NNN, tenant
 * basina benzersiz, gun icinde sirali (Q1).
 */
model Quote {
  id                    String              @id @default(uuid())
  tenantId              String
  accountId             String
  /**
   * S3'un muhatap kisisi (bkz. docs/VARSAYIMLAR.md V28) - teklif olustururken opsiyonel
   * secilir, PostSaleCase/FeedbackSurvey bunu teklif uzerinden miras alir.
   */
  contactId             String?
  quoteNumber           String
  /**
   * Kullanicinin teklife elle verdigi tarih - quoteNumber'in gun-icinde-sayaci
   * (sistemin "simdi"si) ile karistirilmamali, teklif belgesinde gorunen tarih
   * kullanici tarafindan gecmis/gelecek bir gune ayarlanabilir.
   */
  quoteDate             DateTime            @default(now())
  /**
   * Serbest metin, orn. "3 is gunu", "2 hafta", "2-3 hafta".
   */
  leadTime              String?
  /**
   * Tenant'in crm_payment_method_options listesine karsi dogrulanir (bkz.
   * QuotesService.assertValidPaymentMethod, sektor alaniyla ayni desen).
   */
  paymentMethod         String?
  title                 String?
  paymentTerms          String?
  salesTerms            String?
  deliveryTerms         String?
  generalTerms          String?
  /**
   * Secilen IbanOption'in 4 alani olusturma/guncelleme aninda buraya kopyalanir
   * (bkz. IbanOption doc comment'i) - FK degil, snapshot.
   */
  ibanBankName          String?
  ibanAccountHolderName String?
  ibanAccountNumber     String?
  ibanNumber            String?
  status                QuoteStatus         @default(DRAFT)
  approvedAt            DateTime?
  approvedById          String?
  /**
   * Ad-hoc /teklifler ice aktarma (bkz. QuoteItemsEntryMode doc comment'i).
   * MANUAL_TOTAL oldugunda items bos olabilir, PDF/toplam hesaplayicilari
   * manualSubtotal/manualVatAmount/manualCurrency'den okur (bkz. bi-frontend
   * lib/quote-totals.ts getQuoteCurrencyTotals).
   */
  itemsEntryMode        QuoteItemsEntryMode @default(ITEMIZED)
  manualSubtotal        Decimal?            @db.Decimal(14, 2)
  manualVatAmount       Decimal?            @db.Decimal(14, 2)
  manualCurrency        String?
  /**
   * Ad-hoc /teklifler ice aktarma - Product.attributes ile ayni "bilinen alana
   * eslenmeyen ama kaybedilmek istenmeyen kolon" catch-all deseni (bkz.
   * ProductImportsService). quote-imports disinda hic yazilmaz.
   */
  attributes            Json?
  /**
   * Kalemler farkli para birimlerinde olabilir (Product.currency) - teklifin TEK bir
   * genel toplamini gosterebilmek icin kullanicinin sectigi hedef para birimi. Item
   * para birimlerinden biriyle ayni olmak zorunda degil.
   */
  quoteCurrency         String              @default("TRY")
  /**
   * quoteCurrency disindaki her item para biriminin quoteCurrency'ye cevrim kuru
   * snapshot'i - `{ asOf: string, rates: { [currency]: number } }`. Kullanici FxService'ten
   * gelen guncel kuru duzenleyebilir; olusturma/guncelleme aninda buraya donmuslenir,
   * gecmis teklifler farkli gunun kurunu korur (unitPrice ile ayni "snapshot" deseni).
   */
  exchangeRates         Json?
  /**
   * Bir proje birden fazla teklifle iliskilendirilebilir (1 Project : N Quote), ama bir
   * teklif en fazla bir projeye baglidir - bu yuzden FK burada, Quote tarafinda (eskiden
   * Project.quoteId @unique idi, tersiydi - bkz. docs/VARSAYIMLAR.md). Proje
   * olustururken setlenmez; proje duzenleme formundaki "Teklifler" cok-secimli alaniyla
   * (tam degisim/replace semantigi) ayarlanir (bkz. ProjectsService.update).
   */
  projectId             String?
  /**
   * Ad-hoc: markali PDF sablonu (bkz. docs/VARSAYIMLAR.md V41). Nullable ve
   * onDelete: SetNull - sablonsuz teklifler (null) mevcut sade export yolunu
   * degismeden kullanmaya devam eder, bir sablon silinirse onu kullanan teklifler
   * sessizce sablonsuz export'a duser.
   */
  templateId            String?
  /**
   * Ad-hoc revizyon takibi (kullanici istegi, bkz. CLAUDE.md). Teklif REVIZE
   * durumundayken kalemler kaydedilince: o ana kadarki kalemlerin/kurun JSON
   * snapshot'i buraya yazilir, revisionNote ile birlikte - SADECE en son
   * revizyonu tutar (tam gecmis degil, "sadece kendimiz icin" hatirlatma
   * amacli). PDF export'ta hic gosterilmez (QuoteContentBody/print sayfalari
   * bu alanlari okumaz). revisionCount hic sifirlanmaz, /teklifler/yeni'deki
   * firma bazli "X kere revize istedi" uyarisi icin (bkz. QuotesService.
   * getRevisionSummaryForAccount) tum tekliflerde toplanir.
   */
  revisionNote          String?
  revisionSnapshot      Json?
  revisionCount         Int                 @default(0)
  lastRevisedAt         DateTime?
  /**
   * Teklifin "gonderen"i (PDF'te gosterilen temsilci) - /teklifler/yeni'de
   * kullanici tarafindan secilir, varsayilan olarak teklifi olusturan kullanici
   * onceden secili gelir ama degistirilebilir. createdById gibi iliskisel bir
   * FK degil (bkz. createdById doc comment'i) - User.title/phone/email ile
   * birlikte QuotesService.getPrintData'da ayri bir sorguyla cozulur.
   */
  senderId              String?
  createdById           String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?

  tenant         Tenant               @relation(fields: [tenantId], references: [id])
  account        Account              @relation(fields: [accountId], references: [id])
  contact        Contact?             @relation(fields: [contactId], references: [id])
  project        Project?             @relation(fields: [projectId], references: [id])
  template       QuoteTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  items          QuoteItem[]
  opportunity    Opportunity?
  postSaleCase   PostSaleCase?
  purchaseOrders PurchaseOrder[]
  stockMovements StockMovement[]
  drawings       Drawing[]
  statusHistory  QuoteStatusHistory[]

  @@unique([tenantId, quoteNumber])
  @@index([tenantId, accountId])
  @@index([tenantId, contactId])
  @@index([tenantId, status])
  @@index([tenantId, projectId])
  @@index([tenantId, templateId])
  @@index([tenantId, deletedAt])
  @@map("crm_quotes")
}

/**
 * Ad-hoc: /teklifler/:id "Durum" sekmesi (kullanici istegi, bkz. CLAUDE.md) - append-only
 * durum gecmisi ledger'i, StockMovement ile ayni desen. AuditLog'a guvenilmedi: mevcut
 * Quote audit kayitlari eski/yeni durumu meta'ya yazmiyor ve entityId'ye gore
 * sorgulanamiyor (bkz. arastirma notlari). create/update/approve/reject HER durum
 * degisikliginde (ve quote-imports'taki UNSPECIFIED ilk-olusturmada) bir satir ekler,
 * asla guncellenmez/silinmez. Bu ozellik eklenmeden once olusturulmus tekliflerin
 * gecmisi yok - frontend bu durumda Quote.createdAt'ten tek bir "Olusturuldu" satiri
 * sentezler (bkz. docs/VARSAYIMLAR.md).
 */
model QuoteStatusHistory {
  id          String      @id @default(uuid())
  tenantId    String
  quoteId     String
  status      QuoteStatus
  /**
   * REVIZE icin revisionNote, REJECTED icin varsa red gerekcesi. Cogu gecis icin null.
   */
  note        String?
  createdById String
  createdAt   DateTime    @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  quote  Quote  @relation(fields: [quoteId], references: [id])

  @@index([tenantId, quoteId, createdAt])
  @@map("crm_quote_status_history")
}

/**
 * Ad-hoc: markali teklif PDF sablonu (bkz. docs/VARSAYIMLAR.md V41). Ayarlar-formu
 * tarzi: sabit 4 sayfalik tasarim (kapak + detay + kosullar + kapanis), tenant
 * icerigi (logo/gorseller/sirket bilgisi) doldurur. Satis/teslimat kosullari VE
 * banka hesabi bilgisi sablon duzeyinde SABIT degildir - her teklifte zaten ayri
 * ayri girilen Quote.salesTerms/deliveryTerms ve Quote.iban* alanlari otomatik
 * olarak PDF'e cekilir (kullanici karari: sablon olusturuken bunlari tekrar
 * girmek istemiyor).
 * Bir tenant'ta en fazla bir isDefault=true kaydi olur (QuoteTemplatesService
 * transaction ile garanti eder).
 */
/**
 * Ad-hoc (bkz. CLAUDE.md, teklif sablonu alan paritesi): companyPhone/
 * companyEmail/companyAddressLines ve senderName/senderTitle/senderPhone/
 * senderEmail alanlari KALDIRILDI - sirket adres/telefon/eposta artik
 * Tenant.address/phone/email'den (tek, tenant-genel kaynak), gonderen bilgisi
 * artik Quote.senderId -> User'dan (teklif bazinda, her teklifte degisebilir)
 * geliyor. Sablon basina sabit tutulmalari ikisi icin de yanlisti (bkz.
 * docs/VARSAYIMLAR.md).
 */
model QuoteTemplate {
  id                 String   @id @default(uuid())
  tenantId           String
  name               String
  isDefault          Boolean  @default(false)
  logoKey            String?
  coverImageKey      String?
  closingImageKey    String?
  companyDisplayName String
  companyTagline     String?
  createdById        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  quotes Quote[]

  @@index([tenantId])
  @@index([tenantId, isDefault])
  @@map("crm_quote_templates")
}

/**
 * tenantId tasimaz (ayni desen, parent Quote uzerinden izolasyon). unitPrice teklif
 * olusturuldugu anda Product.price'tan kopyalanir ama satir bazinda manuel ezilebilir (Q3) -
 * burada saklanan deger Product.price'tan bagimsiz, teklifin olusturuldugu andaki degeri
 * korur. discountNote Q5'in otomatik notu.
 */
model QuoteItem {
  id           String   @id @default(uuid())
  quoteId      String
  productId    String
  quantity     Decimal  @db.Decimal(14, 3)
  unitPrice    Decimal  @db.Decimal(14, 2)
  /**
   * unitPrice ile ayni snapshot semantigi: satir olusturulurken/guncellenirken
   * Product.currency'den kopyalanir, client'tan kabul edilmez (bkz. resolveItems).
   */
  currency     String   @default("TRY")
  discountPct  Decimal  @default(0) @db.Decimal(5, 2)
  discountNote String?
  vatPct       Decimal  @default(0) @db.Decimal(5, 2)
  /**
   * Maliyet sekmesi (quote-cost-content.tsx) icin donmus (snapshot) WAC maliyeti.
   * unitPrice/currency ile ayni mantik: satir olusturulurken/guncellenirken
   * Product.avgCost'tan kopyalanir - boylece urunun GUNCEL avgCost'u degisse bile
   * (yeni stok girisiyle) bu teklifteki kar/maliyet hesabi degismez.
   */
  costPriceAtSale Decimal? @db.Decimal(14, 4)
  createdAt    DateTime @default(now())

  quote   Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("crm_quote_items")
}

/**
 * S1 (bkz. docs/VARSAYIMLAR.md V28): Quote.status APPROVED'a ulastigi HER an (dogrudan
 * olusturma, approve endpoint'i, veya update() sirasinda iskonto siniri altina inme) tek bir
 * PostSaleCase acilir (quoteId @unique, idempotent upsert - bkz. QuotesService.ensurePostSaleCase).
 * status alani DB'de TUTULMAZ - Account.missingCriticalFields ile ayni "hesaplanan alan"
 * konvansiyonu (bkz. VARSAYIMLAR V18), reminderSentAt/feedbackReceivedAt'tan servis katmaninda
 * turetilir. reminderAt, onay anindaki TenantSetting(crm.postSaleFollowUpDays, varsayilan 14)
 * degeriyle hesaplanir (S2).
 */
model PostSaleCase {
  id                 String    @id @default(uuid())
  tenantId           String
  quoteId            String    @unique
  accountId          String
  contactId          String?
  reminderAt         DateTime
  reminderSentAt     DateTime?
  feedbackReceivedAt DateTime?
  feedbackNote       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  quote          Quote           @relation(fields: [quoteId], references: [id])
  account        Account         @relation(fields: [accountId], references: [id])
  contact        Contact?        @relation(fields: [contactId], references: [id])
  feedbackSurvey FeedbackSurvey?

  @@index([tenantId, reminderAt])
  @@index([tenantId, accountId])
  @@map("crm_post_sale_cases")
}

/**
 * S3 (bkz. docs/VARSAYIMLAR.md V28): anket SADECE e-posta olarak gonderilir (mevcut
 * text-only MailService), yanit temsilci tarafindan elle isaretlenir - tokenli bir public
 * link/form YAZILMADI. Bu yuzden taslak semadaki `response Json` yerine serbest metin
 * `responseNote String?` yeterli gorulmustur (Q7/ProductDiscountPolicy'deki 1:1-basitlestirme
 * kararlariyla ayni gerekce - bkz. docs/VARSAYIMLAR.md). postSaleCaseId @unique: bir vaka
 * icin en fazla bir anket kaydi, yeniden gonderim sentAt'i gunceller (resend).
 */
model FeedbackSurvey {
  id             String    @id @default(uuid())
  tenantId       String
  postSaleCaseId String    @unique
  contactId      String
  sentAt         DateTime
  respondedAt    DateTime?
  responseNote   String?
  createdAt      DateTime  @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  postSaleCase PostSaleCase @relation(fields: [postSaleCaseId], references: [id])
  contact      Contact      @relation(fields: [contactId], references: [id])

  @@map("crm_feedback_surveys")
}

/**
 * Faz 11g (CLAUDE.md SS2.3.10 P1-P3). projectNumber formati PRJ-YYYY-AA-GG-NNN (Q1 ile
 * ayni gun-icinde-sirali desen, bkz. ProjectsService). Bir proje birden fazla teklifle
 * iliskilendirilebilir, teklif setleme proje olusturulurken degil, proje duzenleme
 * formundaki cok-secimli "Teklifler" alaniyla sonradan yapilir (bkz. Quote.projectId
 * doc comment'i - FK orada). Bu iliski uzerinden gecen bir satin alma siparisi
 * yoktur artik - PurchaseOrder sadece Quote'a baglidir, projesi (varsa)
 * `purchaseOrder.quote.project` uzerinden turetilir (eskiden PurchaseOrder.projectId
 * ayrica saklaniyordu, teklif<->proje iliskisi siparis olusturulduktan SONRA
 * kurulursa senkronize kalamiyordu - bkz. docs/VARSAYIMLAR.md). estimatedBudget/
 * actualCost, raporlamadaki kazanc formulunun (teklif tutari - maliyet - masraf, P3)
 * girdileri - formulun kendisi bu fazda hesaplanmiyor/yazilmiyor, sadece degerler
 * saklaniyor. `name` taslak semada (CLAUDE.md SS7.2) yoktu, listede/UI'da projeyi
 * tanimlamak icin pratik olarak eklendi (Product/Quote'taki gibi tum entity'lerin bir
 * adi/numarasi var).
 */
model Project {
  id              String    @id @default(uuid())
  tenantId        String
  projectNumber   String
  accountId       String
  name            String
  estimatedBudget Decimal   @db.Decimal(14, 2)
  actualCost      Decimal?  @db.Decimal(14, 2)
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  account      Account              @relation(fields: [accountId], references: [id])
  quotes       Quote[]
  responsibles ProjectResponsible[]
  attachments  ProjectAttachment[]

  @@unique([tenantId, projectNumber])
  @@index([tenantId, accountId])
  @@index([tenantId, deletedAt])
  @@map("crm_projects")
}

/**
 * Proje ile ilgili dosyalar (sozlesme, teknik sartname vb.) - MessageAttachment ile
 * ayni desen (fileKey R2'de, orijinal ad/mimeType/boyut burada), tek fark bir Message'a
 * degil dogrudan bir Project'e bagli olmasi.
 */
model ProjectAttachment {
  id        String   @id @default(uuid())
  tenantId  String
  projectId String
  fileKey   String
  fileName  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId])
  @@map("crm_project_attachments")
}

/**
 * "Bizden ilgili" (dahili sorumlu) kullanicilar - CalendarEventAttendee.userId ile
 * ayni desen: gercek FK degil (User relation yok, sadece id); isimler ProjectsService
 * tarafindan ayrica sorgulanip map'lenir. Coklu secim, replace semantigiyle yonetilir
 * (bkz. UpdateProjectDto.responsibleUserIds).
 */
model ProjectResponsible {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("crm_project_responsibles")
}

/**
 * Faz 11h (CLAUDE.md SS2.3.11 SP1-SP3). Onaylanmis bir teklifden (Quote.status ==
 * APPROVED) olusturulur - QuotesController'daki POST /quotes/:id/create-purchase-order
 * ucu tetikler. orderNumber SIP-YYYY-AA-GG-NNN formatinda, Quote/Project ile ayni
 * gun-icinde-sirali sayac deseni. Kasitli olarak kendi projectId alani YOK - proje
 * iliskisi her zaman `quote.project` uzerinden okunur, boylece teklif<->proje
 * baglantisi siparis olusturulduktan sonra kurulsa/degisse bile tutarli kalir.
 * Ad-hoc (2026-09-28, kullanici istegiyle): /siparisler/yeni sayfasindan dogrudan
 * POST /purchase-orders ile de olusturulabilir (bkz. PurchaseOrdersService.create) -
 * bu akiste teklif zorunlu degildir, quoteId opsiyonel bir baglantidir (Project.quoteId
 * ile ayni "zorunlu degil" deseni, bkz. SP1-SP3 dokumaninda P2).
 */
model PurchaseOrder {
  id          String              @id @default(uuid())
  tenantId    String
  orderNumber String
  /**
   * Ad-hoc (2026-10-05, kullanici istegiyle): opsiyonel, nullable baslik -
   * /siparisler listesinde ve arama kutusunda kullanilir (Quote.title ile ayni
   * desen).
   */
  title       String?
  quoteId     String?
  status      PurchaseOrderStatus @default(DRAFT)
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  tenant Tenant              @relation(fields: [tenantId], references: [id])
  quote  Quote?              @relation(fields: [quoteId], references: [id])
  items  PurchaseOrderItem[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, deletedAt])
  @@index([tenantId, quoteId])
  @@map("crm_purchase_orders")
}

/**
 * SP2/SP3: kaynak ("source") teklif satirindan mi (QUOTE) yoksa siparise ozel ek bir
 * kalemden mi (EXTRA) geldigini isaretler. productId, EXTRA satirlarda opsiyoneldir
 * (serbest metin kalem de eklenebilir - SP3). description QuoteItem'in aksine her
 * zaman tutulur (urun adinin kopyasi ya da serbest metin), tenantId tasimaz (QuoteItem
 * ile ayni desen).
 */
model PurchaseOrderItem {
  id              String                  @id @default(uuid())
  purchaseOrderId String
  productId       String?
  description     String
  quantity        Decimal                 @db.Decimal(14, 3)
  source          PurchaseOrderItemSource
  createdAt       DateTime                @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product?      @relation(fields: [productId], references: [id])

  @@map("crm_purchase_order_items")
}

/**
 * Faz 11h (CLAUDE.md SS2.3.12 ST1). Urun basina tek stok satiri (depo/warehouse
 * ayrimi bu turda kapsam disi, taslak semadaki warehouseId eklenmedi - basit tutuldu).
 * Dusuk stok uyarisi (ST1) GET /stock-items/low-stock'ta uygulama katmaninda
 * hesaplanir (Product.minStockLevel ile karsilastirma).
 */
model StockItem {
  id          String   @id @default(uuid())
  tenantId    String
  productId   String
  /**
   * Depo bazli stok (ad-hoc, bkz. CLAUDE.md) - bir urun birden fazla depoda
   * farkli miktarlarla bulunabilir, her (urun, depo) ciftinin kendi satiri vardir.
   */
  warehouseId String
  quantity    Decimal  @default(0) @db.Decimal(14, 3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([tenantId, productId, warehouseId])
  @@index([tenantId])
  @@index([tenantId, warehouseId])
  @@map("crm_stock_items")
}

/**
 * Hareket turleri - bkz. docs/PLAN_STOK_MALIYET.md. Sadece INCREASE Product.avgCost'u
 * degistirir (WAC formulu); digerleri miktari degistirir, maliyeti degistirmez.
 */
enum StockMovementType {
  INCREASE
  DECREASE
  QUOTE_SALE
  TRANSFER_OUT
  TRANSFER_IN
  CORRECTION
}

/**
 * Append-only stok hareket defteri (ledger) - bkz. docs/PLAN_STOK_MALIYET.md. Eskiden
 * "/envanter?tab=stockHistory" AuditLog'un meta JSON'undan yeniden kuruluyordu; artik
 * gercek, sorgulanabilir bir tablo. Hicbir satir guncellenmez/silinmez (soft-delete
 * gerektirmez).
 */
model StockMovement {
  id                String            @id @default(uuid())
  tenantId          String
  productId         String
  warehouseId       String
  type              StockMovementType
  quantity          Decimal           @db.Decimal(14, 3)
  /**
   * Sadece INCREASE'de dolu - diger turlerde maliyet degismedigi icin null.
   */
  unitCost          Decimal?          @db.Decimal(14, 4)
  previousAvgCost   Decimal?          @db.Decimal(14, 4)
  newAvgCost        Decimal?          @db.Decimal(14, 4)
  previousQuantity  Decimal           @db.Decimal(14, 3)
  newQuantity       Decimal           @db.Decimal(14, 3)
  /**
   * QUOTE_SALE'in hangi teklifin onayindan geldigini izlemek icin.
   */
  quoteId           String?
  note              String?
  /**
   * TRANSFER_OUT <-> TRANSFER_IN ciftini birbirine baglar.
   */
  relatedMovementId String?
  createdById       String
  createdAt         DateTime          @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  quote     Quote?    @relation(fields: [quoteId], references: [id])

  @@index([tenantId, productId, createdAt])
  @@index([tenantId, quoteId])
  @@map("crm_stock_movements")
}

/**
 * Depo (ad-hoc, bkz. CLAUDE.md) - tenant'in fiziksel/mantiksal stok lokasyonlari.
 */
model Warehouse {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  address   String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  stockItems     StockItem[]
  stockMovements StockMovement[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("crm_warehouses")
}

/**
 * Faz 11j (CLAUDE.md SS2.3.1 G3) - sistem ici mesajlasma, 3. parti mail servisi degil.
 * relatedEntity CalendarEvent.relatedEntityType'in aksine gercek enum: Project/Quote/
 * Interaction bu fazda zaten var, String'e gevsetmeye gerek yok.
 */
model Message {
  id              String                @id @default(uuid())
  tenantId        String
  conversationId  String                @default(uuid())
  senderId        String
  subject         String
  body            String
  sentAt          DateTime              @default(now())
  relatedEntity   MessageRelatedEntity?
  relatedEntityId String?
  /**
   * "Ajanda > Toplanti Raporu Olustur" akisindan (isMeeting=true bir CalendarEvent'e
   * bagli) gonderilen mesajlarda true - meetingEventId verildiginde MessagesService.create()
   * tarafindan setlenir, /mesajlar filtresinde ayirt etmek icin (bkz. MessageQuerySchema).
   */
  isMeetingReport Boolean               @default(false)
  createdById     String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  recipients  MessageRecipient[]
  attachments MessageAttachment[]

  @@index([tenantId, relatedEntity, relatedEntityId])
  @@index([tenantId, sentAt])
  @@index([tenantId, conversationId])
  @@index([tenantId, isMeetingReport])
  @@map("crm_messages")
}

/**
 * CalendarEventAttendee ile ayni desen: userId gercek FK degil (User'a relation eklemek
 * gereksiz bir back-relation dizisi zorunlu kilar), tenant izolasyonu messageId uzerinden
 * Message'a cascade ile miras alinir - kendi tenantId'si yok, TENANT_SCOPED_MODELS'e girmez.
 */
model MessageRecipient {
  id        String               @id @default(uuid())
  messageId String
  userId    String
  kind      MessageRecipientKind
  readAt    DateTime?
  createdAt DateTime             @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, kind])
  @@map("crm_message_recipients")
}

/**
 * Mesaj eki (G3 genisletmesi, dosya ekleme) - R2'de PILENS/{env}/{tenantId}/messages/...
 * anahtar sablonuyla saklanir (bkz. FilesController). Mesaj olusturulmadan once
 * yuklenip (POST /messages/attachments) donen anahtarla birlikte mesaj create
 * body'sine referans verilir, bu yuzden tenantId burada da tutulur (Message'a FK
 * uzerinden erisilebilir olsa da, tenant-scoped extension'in filtreleyebilmesi icin).
 */
model MessageAttachment {
  id        String   @id @default(uuid())
  tenantId  String
  messageId String
  fileKey   String
  fileName  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([tenantId, messageId])
  @@map("crm_message_attachments")
}

/**
 * Kisisel yildizlama (mesaj degil, KONUSMA bazli - conversationId gercek bir FK
 * degil, sadece Message.conversationId'deki mantiksal gruplama anahtari). Ayri bir
 * tablo secildi cunku MessageRecipient'a baglamak, gonderenin kendi "Gonderilen"
 * kutusundaki konusmalari yildizlamasini imkansiz kilardi (o konusmalarda kendisi
 * icin MessageRecipient satiri yok).
 */
model MessageStar {
  id             String   @id @default(uuid())
  tenantId       String
  userId         String
  conversationId String
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, userId, conversationId])
  @@index([tenantId, userId])
  @@map("crm_message_stars")
}

/**
 * Generic bildirim - herhangi bir modul (Ajanda, ileride baskalari) belirli bir
 * kullaniciya bildirim gondermek icin bunu kullanir. relatedEntityType/relatedEntityId
 * CalendarEvent.relatedEntityType ile ayni desen (gercek FK degil, serbest metin) -
 * bildirimin hangi tur kayda isaret edecegi onceden bilinen sabit bir kume degil,
 * NotificationType arttikca cesitlenecek, bu yuzden Message.relatedEntity gibi
 * kapali bir enum yerine string tercih edildi.
 */
model Notification {
  id                String           @id @default(uuid())
  tenantId          String
  recipientUserId   String
  type              NotificationType
  title             String
  body              String?
  relatedEntityType String?
  relatedEntityId   String?
  createdById       String?
  readAt            DateTime?
  createdAt         DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, recipientUserId, readAt, createdAt])
  @@map("notifications")
}

/**
 * Tekliften Otomatik Teknik Cizim modulu (bkz. docs/VARSAYIMLAR.md V52,
 * docs/YOL_HARITASI.md "Yeni Modul: Tekliften Otomatik Teknik Cizim", Faz D1).
 * `drawings` modulu (MODULE_REGISTRY) altinda, tenant bazinda acilir/kapanir.
 */

/**
 * Urunun pano cizim motorunda kullanilabilmesi icin gereken teknik/geometrik
 * bilgiler. Product'a 1:1, tum alanlar opsiyonel - doldurulmamissa o urun cizim
 * motorunda kullanilamaz, bu normal bir durumdur (bkz. V52). tenantId tasimaz -
 * QuoteItem ile ayni desen, izolasyon parent Product uzerinden saglanir.
 */
model ProductDrawingSpec {
  id                  String   @id @default(uuid())
  productId           String   @unique
  widthMm             Decimal? @db.Decimal(10, 2)
  heightMm            Decimal? @db.Decimal(10, 2)
  depthMm             Decimal? @db.Decimal(10, 2)
  /**
   * Proje-1'deki lib_key deseniyle ayni - DrawingLibraryComponent.key'e serbest
   * (FK olmayan) referans. FK olmamasinin nedeni: kutuphane tenant bazinda farkli
   * olabilir, urun olusturuldugu anda henuz o tenant'a kopyalanmamis olabilir.
   */
  libraryComponentKey String?
  /**
   * Baglanti noktalari - serbest JSON dizi ({label, x, y}[] gibi), render motoru
   * (D4) tarafindan yorumlanir. Analitik sorgulanmaz, EAV kisidi (CLAUDE.md §16)
   * bu alana uygulanmaz (domain-ozel cizim verisi, dataset/query motoruna hic
   * girmez).
   */
  connectionPoints    Json?
  /**
   * Pano tipindeki varsayilan sira (bant/yerlesim sirasi) - auto-pack
   * algoritmasinin soldan saga/bant ici siralama ipucu.
   */
  bandOrder           Int?
  /**
   * Urunun otomatik yerlesimde HANGI banda (DrawingPanelTemplate.layout.bands[].key)
   * ait oldugu - D4'te kesfedilen bir sema boslugu, D6'da (Quote->Drawing otomasyonu)
   * cozuldu (bkz. docs/VARSAYIMLAR.md V53/V54). bandOrder bant ICI sira, bandKey ise
   * HANGI bant sorusunu cevaplar - category tek basina yetmiyordu (ayni kategorideki
   * ana kesici ile cikis kesicileri farkli bantta olabiliyor).
   */
  bandKey             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("crm_product_drawing_specs")
}

/**
 * Tenant bazinda pano cizim kutuphanesi elemani (role, kontaktor, PLC/IO modulu,
 * klemens, kablo kanali/duct, bara vb.) - bkz. docs/VARSAYIMLAR.md V52. Built-in
 * (isBuiltIn=true) satirlar seed'den gelir, bir provisioning servisi (Faz D3) ile
 * her tenant'a KOPYALANIR - global mutasyona ugramazlar, tenant kendi kopyasini
 * serbestce duzenleyebilir ("built-in ama duzenlenebilir" ilkesi).
 */
model DrawingLibraryComponent {
  id              String   @id @default(uuid())
  tenantId        String
  /**
   * Tenant icinde benzersiz, insan-okunur anahtar (proje-1'deki lib_key deseni).
   */
  key             String
  name            String
  category        String
  defaultWidthMm  Decimal  @db.Decimal(10, 2)
  defaultHeightMm Decimal  @db.Decimal(10, 2)
  /**
   * Render motorunun (D4) kullanacagi sembol tanimi - ilk surumde serbest JSON
   * (sekil/renk/etiket), sembol kutuphanesi buyudukce genisleyebilir.
   */
  symbol          Json?
  isBuiltIn       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("crm_drawing_library_components")
}

/**
 * OG_CELL (orta gerilim hucresi) Faz D8'de eklendi - bkz. docs/VARSAYIMLAR.md V56.
 * Render motoru (render-svg.ts) tipten habersiz, sadece layout bantlarini/elemanlarini
 * okur - bu yuzden yeni tip icin motor kodunda degisiklik gerekmedi, sadece yeni bir
 * built-in sablon/kutuphane seed'i eklendi.
 */
enum DrawingTemplateType {
  AG_BACKPLATE
  OG_CELL
}

/**
 * Tenant bazinda pano sablonu - bkz. docs/VARSAYIMLAR.md V52. Built-in satirlar
 * seed'den gelir, DrawingLibraryComponent ile ayni provisioning deseniyle (Faz D3)
 * tenant'a kopyalanir.
 */
model DrawingPanelTemplate {
  id        String              @id @default(uuid())
  tenantId  String
  name      String
  type      DrawingTemplateType @default(AG_BACKPLATE)
  widthMm   Decimal             @db.Decimal(10, 2)
  heightMm  Decimal             @db.Decimal(10, 2)
  /**
   * Varsayilan bant/yerlesim tanimi (band sirasi, bosluk/clearance kurallari) -
   * auto-pack algoritmasinin (D4) baslangic noktasi. Serbest JSON, EAV kisidi
   * (analitik veri degil, cizim domain verisi) bu alana uygulanmaz.
   */
  layout    Json
  isBuiltIn Boolean             @default(false)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  drawings Drawing[]

  @@index([tenantId])
  @@map("crm_drawing_panel_templates")
}

enum DrawingStatus {
  DRAFT
  FINALIZED
}

/**
 * Tek bir pano/hucre cizimi - bkz. docs/VARSAYIMLAR.md V52. Bir teklif (Quote)
 * birden fazla pano/hucre icerebilir, bu yuzden 1 Quote -> N Drawing (karar 6).
 * `model` alani uc gorusu birden tutar (model.views.{internal,coverPlate,external})
 * + model.busbars (karar 2-3) - export (PDF/SVG, Faz D7) HER ZAMAN bu alandan
 * uretilir, canvas/ekran goruntusunden degil (proje-1'in "tek dogruluk kaynagi"
 * ilkesi).
 */
model Drawing {
  id              String        @id @default(uuid())
  tenantId        String
  quoteId         String
  templateId      String?
  /**
   * PDF pre-processing'in (Faz D6) "hangi pano/hucreye ait" ayristirmasindan gelen
   * serbest etiket (orn. "Pano-1", "Giris Hucresi") - FK degil, sadece kullaniciya
   * gosterilen bir grup adi.
   */
  panelGroupLabel String?
  name            String
  status          DrawingStatus @default(DRAFT)
  /**
   * Tum cizim verisi (3 gorunum + bara dahil). Serbest JSON, EAV kisidi bu alana
   * uygulanmaz - analitik sorgulanmaz, sadece render motoru tarafindan okunur/yazilir.
   */
  model           Json
  exportedAt      DateTime?
  /**
   * Son uretilen PDF/SVG export dosyasinin R2 anahtari (urun gorseli/avatar ile ayni depolama deseni).
   */
  exportFileKey   String?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  tenant   Tenant                @relation(fields: [tenantId], references: [id])
  quote    Quote                 @relation(fields: [quoteId], references: [id])
  template DrawingPanelTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([tenantId, quoteId])
  @@index([tenantId, deletedAt])
  @@map("crm_drawings")
}
