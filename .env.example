PORT=3011
# 3001 sibling nestjs-react (crm-backend) projesi tarafindan kullaniliyor olabilir; cakisma varsa PORT'u degistir.
# Yerel gelistirme (Docker kullanilmiyor): kendi Postgres kullanicini yaz.
# Deploy sirasinda docker-compose.yml'deki pilens/pilens kimlik bilgileri kullanilacak.
DATABASE_URL="postgresql://YOUR_LOCAL_USER@localhost:5432/pilens_bi?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
SMTP_HOST="localhost"
SMTP_PORT=1025
CORS_ORIGIN="http://localhost:5173"
# PDF export (Playwright) icin panonun goruntulenecegi frontend adresi.
FRONTEND_URL="http://localhost:5173"
# Yuklenen dosyalarin (urun gorseli, avatar) proxy'lendigi backend'in kendi genel adresi -
# modules/files/files.controller.ts URL'leri bu adrese gore uretir (sonunda / OLMASIN).
# Prod'da gercek API domain'i olmali. bkz. docs/VARSAYIMLAR.md V34.
API_PUBLIC_URL="http://localhost:3011/api/v1"
# Chatbot asistani icin (modules/chatbot). OpenAI SDK'si kullanilir; OPENAI_BASE_URL
# bos birakilirsa gercek OpenAI'a gider (https://platform.openai.com/api-keys).
# Gemini'nin OpenAI-uyumlu ucuna karsi calistirmak icin (docs/VARSAYIMLAR.md V14):
#   OPENAI_API_KEY=<Gemini API anahtari>
#   OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
#   OPENAI_MODEL="gemini-3.6-flash" # Google'in guncel model adlarini kontrol et, siklikla degisiyor
OPENAI_API_KEY="change-me"
OPENAI_BASE_URL=""
OPENAI_MODEL="gpt-4o-mini"
# Urun gorselleri (Faz 11i, U1) ve kullanici avatari (Faz 11j, G2) icin Cloudflare R2
# (S3-uyumlu depolama). Cloudflare panelinde: R2 > bir bucket olustur (ornek: pilens) >
# "Manage R2 API Tokens" ile Object Read & Write izinli bir token uret (Account ID, Access
# Key ID, Secret Access Key oradan alinir). Nesne anahtari sablonu:
# PILENS/{development|production}/{tenantId}/{product-images|avatars}/{id}.{ext} (urun/
# kullanici basina tek gorsel oldugu icin sabit anahtar; degistirmede cache-busting icin
# yanit URL'ine otomatik ?v={updatedAt} eklenir).
# NOT: Bucket'in "Public Development URL"sini (r2.dev) ACMAYA GEREK YOK - dosyalar artik
# backend'in kendi /files ucundan proxy'leniyor (bkz. modules/files/, docs/VARSAYIMLAR.md
# V34; r2.dev SLA'siz/guvenilmez bulundugu icin bu yaklasimdan vazgecildi). Bucket private
# kalabilir.
# Bos birakilirsa resim/avatar yukleme uclari 500 STORAGE_NOT_CONFIGURED doner, platformun
# geri kalani etkilenmez.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="pilens"
