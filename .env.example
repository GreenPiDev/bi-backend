PORT=3001
# Yerel gelistirme (Docker kullanilmiyor): kendi Postgres kullanicini yaz.
# Deploy sirasinda docker-compose.yml'deki pusula/pusula kimlik bilgileri kullanilacak.
DATABASE_URL="postgresql://YOUR_LOCAL_USER@localhost:5432/pusula_bi?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
SMTP_HOST="localhost"
SMTP_PORT=1025
CORS_ORIGIN="http://localhost:5173"
